{
  "name": "omo-orca-dag",
  "version": "0.1.0",
  "description": "Live OmO workflow DAGs in an Orca side pane.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyunjunJeon/omo-orca-dag.git"
  },
  "homepage": "https://github.com/HyunjunJeon/omo-orca-dag#readme",
  "bugs": {
    "url": "https://github.com/HyunjunJeon/omo-orca-dag/issues"
  },
  "keywords": [
    "omo",
    "orca",
    "dag",
    "tui",
    "workflow"
  ],
  "type": "module",
  "bin": {
    "omo-orca-dag": "bin/omo-orca-dag.mjs"
  },
  "exports": {
    ".": "./dist/extension.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "extension.mjs",
    "scripts/install.mjs",
    "LICENSE",
    "README.md",
    "README_KO.md",
    "CONTRIBUTING.md",
    "VERIFICATION.md",
    "RELEASING.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "check": "npm test && npm run build && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run build && npm run test:package"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "node-pty": "1.1.0"
  }
}
